# Скопируй в .env.local и заполни. .env.local в git не попадает.

# Провайдер модели: openai или gemini. Пусто — берётся тот, у кого заполнены ключ и модель
# (сначала OpenAI, потом Gemini). Ключи — только на сервере, никогда не в клиенте.
AI_PROVIDER=

# OpenAI. Модель задаётся здесь, в коде не хардкодим
OPENAI_API_KEY=
OPENAI_MODEL=

# Gemini: ключ из Google AI Studio (https://aistudio.google.com/apikey), модель — здесь же.
# Можно перечислить запасные модели через запятую: если первая перегружена, запрос уйдёт следующей.
# Например: gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-2.5-flash-lite
GEMINI_API_KEY=
GEMINI_MODEL=

# Supabase: адрес проекта и публичный ключ (sb_publishable_…). Используются только на сервере.
# Таблицы закрыты, сервер вызывает функции из supabase/schema.sql. Пусто — урок живёт во вкладке, без кода для учеников.
SUPABASE_URL=
SUPABASE_KEY=

# true — генерация отдаёт fixtures/ без вызова модели (для рецензентов и при лимитах)
DEMO_MODE=false
