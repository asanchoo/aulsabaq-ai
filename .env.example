# Скопируй в .env.local и заполни. .env.local в git не попадает.

# OpenAI — только на сервере, никогда не в клиенте
OPENAI_API_KEY=
# Модель задаётся здесь, в коде не хардкодим
OPENAI_MODEL=

# Supabase — доступ только из серверных роутов
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# true — генерация отдаёт fixtures/ без вызова модели (для рецензентов и при лимитах)
DEMO_MODE=false
